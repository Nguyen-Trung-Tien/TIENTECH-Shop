{
  "name": "tientech-shop",
  "version": "1.0.0",
  "private": true,
  "description": "TIENTECH-Shop Monorepo Root",
  "workspaces": [
    "BackEnd",
    "FrontEnd"
  ],
  "scripts": {
    "dev:backend": "npm run dev --prefix BackEnd",
    "dev:frontend": "npm run dev --prefix FrontEnd",
    "test:backend": "npm run test --prefix BackEnd",
    "test:frontend": "npm run test --prefix FrontEnd",
    "test": "npm run test:backend && npm run test:frontend",
    "lint:frontend": "npm run lint --prefix FrontEnd",
    "lint": "npm run lint:frontend",
    "prepare": "node -e \"if (!process.env.CI && process.env.NODE_ENV !== 'production') { try { require('child_process').execSync('husky', { stdio: 'inherit' }); } catch (e) {} }\""
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
